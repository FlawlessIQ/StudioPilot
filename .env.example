# Public web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=development
# Auth, Firestore-backed UI, and external providers can be activated independently.
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_PROVIDER_MODE=mock
# Deprecated compatibility switch. Remove after all deployed environments use the
# three explicit mode variables above.
NEXT_PUBLIC_INTEGRATION_MODE=mock
NEXT_PUBLIC_CRM_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_WORKFLOW_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_STUDIO_IMPORT_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-east4
NEXT_PUBLIC_BOOKING_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_PROPOSAL_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_PLANNING_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_CREW_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_POST_EVENT_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_BILLING_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_SAAS_ADMIN_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_ONBOARDING_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_MEMBERSHIP_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
PDF_SERVICE_URL=
MALWARE_SCAN_SERVICE_URL=
NEXT_PUBLIC_INTEGRATION_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
NEXT_PUBLIC_DATA_FUNCTIONS_URL=http://127.0.0.1:5001/studiohub-dev/us-central1
# Production App Hosting uses a same-origin proxy and private Cloud Functions.
FUNCTIONS_HTTPS_ORIGIN=
FUNCTIONS_RUN_HOST_SUFFIX=
OAUTH_CALLBACK_URL=http://127.0.0.1:5001/studiohub-dev/us-central1/integrationOAuth
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
PROVIDER_MOCK_MODE=true
# Outbound email has an independent production gate so queued jobs can be
# processed safely while provider integrations remain in mock mode.
EMAIL_DELIVERY_MODE=mock
SEED_DEMO_PASSWORD=
SEED_TENANT_ID=
SEED_WEDDING_PACKAGE_CENTS=650000

# Firebase client configuration (safe to expose; protected by rules and App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studiohub-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin / Google Cloud server configuration
GOOGLE_CLOUD_PROJECT=studiohub-dev
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_BASE64=
SESSION_COOKIE_SECRET=
GUEST_LINK_SIGNING_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Provider credentials — use Secret Manager in production
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET are the PLATFORM's own Stripe
# account — billing studios for their StudioCue subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_MULTI_BRAND_MONTHLY=
STRIPE_PRICE_MULTI_BRAND_YEARLY=

# Stripe Connect — lets a studio connect its OWN Stripe account so client
# retainer invoice payments land directly with the studio. STRIPE_CLIENT_ID
# is the Connect application id (ca_...) from the Connect settings page;
# there's no separate Connect client secret to configure — Stripe's token
# exchange uses STRIPE_SECRET_KEY above for that. STRIPE_CONNECT_WEBHOOK_SECRET
# is the signing secret for a *separate* Connect webhook endpoint (configured
# to receive connected-account events), distinct from STRIPE_WEBHOOK_SECRET.
STRIPE_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
QUICKBOOKS_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthQuickBooksCallback

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthGoogleCalendarCallback

# Address autocomplete for venue and address fields (Places API (New)).
# Server-only on purpose — never prefix this NEXT_PUBLIC_. Both lookup
# routes proxy it so the key never reaches a browser, where a
# referrer-restricted key would still be a spendable secret in page source.
# Leave it empty and every address field falls back to a small set of
# sample venues, disclosed as such in the UI.
# Enable in Google Cloud: "Places API (New)". Restrict the key to that API.
GOOGLE_PLACES_API_KEY=

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthZoomCallback

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_WEBHOOK_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthDropboxCallback

DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthDocusignCallback

# OAuth client for connecting a studio's Dropbox Sign account.
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_CLIENT_SECRET=
# The app's API key — Dropbox Sign signs webhook callbacks with this
# (HMAC over event_time+event_type), not a separate webhook secret.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_REDIRECT_URI=http://localhost:5001/studiohub-dev/us-central1/oauthDropboxSignCallback

SENDGRID_API_KEY=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_INBOUND_DOMAIN=
SENDGRID_INBOUND_TOKEN=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_INBOUND_DOMAIN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_EXTRACTION_MODEL=
VERTEX_AI_DRAFTING_MODEL=
VERTEX_AI_SCHEDULE_MODEL=
VERTEX_AI_RISK_MODEL=
VERTEX_AI_COPILOT_MODEL=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
