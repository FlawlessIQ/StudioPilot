# Copy to .env.studiohub-prod for production Function deployments.
# Keep provider credentials in Secret Manager, never in this file.
PROVIDER_MOCK_MODE=true
BILLING_MOCK_MODE=true
PDF_SERVICE_URL=https://studiohub-pdf-988256939236.us-east4.run.app
MALWARE_SCAN_SERVICE_URL=https://studiohub-file-safety-988256939236.us-east1.run.app
VERTEX_AI_PROJECT_ID=studiohub-prod
VERTEX_AI_LOCATION=us-east4
# Must match apphosting.yaml's NEXT_PUBLIC_APP_URL exactly — the OAuth
# callback proxy (app/api/integrations/oauth/callback/route.ts) rejects a
# Function's post-auth redirect if the two disagree.
NEXT_PUBLIC_APP_URL=https://studio-cue.com
# Every provider console registers this exact URL. It must be the canonical
# custom domain, never the *.hosted.app App Hosting host: a provider that
# only trusts studio-cue.com rejects the authorize request before the user
# can approve it (Zoom answers "Invalid redirect ... (4,700)").
OAUTH_CALLBACK_URL=https://studio-cue.com/api/integrations/oauth/callback
EMAIL_DELIVERY_MODE=mock
# Required whenever EMAIL_DELIVERY_MODE=live. sendEmailJob() throws
# SENDGRID_NOT_CONFIGURED without it, and retryableJobFailure() classes that
# as permanent — so every queued email dead-letters with no retry. The
# address must sit on a SendGrid-authenticated domain (studio-cue.com is).
SENDGRID_FROM_EMAIL=verified-sender@example.com
# Leave unset in multi-tenant deployments: it overrides every studio's own
# name with one flat value. Unset, the from name falls back per tenant to
# that studio's brand (brandContext() in operations/jobs.ts), which is the
# white-label behaviour. reply_to already falls back to the tenant's own
# contact address, so only the envelope from needs the shared domain.
# SENDGRID_FROM_NAME=StudioCue
# Must equal the SendGrid Inbound Parse hostname exactly — COI reply
# addresses are minted as coi+<token>@${SENDGRID_INBOUND_DOMAIN}.
SENDGRID_INBOUND_DOMAIN=inbound.studio-cue.com
# OAuth client IDs are plain, non-secret app identifiers (only the paired
# CLIENT_SECRET goes in Secret Manager) — except QUICKBOOKS_CLIENT_ID,
# which functions/src/integrations/oauth.ts binds as a secret instead.
DROPBOX_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
ZOOM_CLIENT_ID=
DOCUSIGN_CLIENT_ID=
DROPBOX_SIGN_CLIENT_ID=
STRIPE_CLIENT_ID=
QUICKBOOKS_API_BASE_URL=https://quickbooks.api.intuit.com
DOCUSIGN_OAUTH_BASE_URL=https://account.docusign.com
# Optional per-provider override for the rare provider whose OAuth app is
# registered against a different host than OAUTH_CALLBACK_URL.
# Pattern: ${PROVIDER}_OAUTH_CALLBACK_URL — see redirectUriFor() in
# functions/src/integrations/oauth.ts. None are needed while every provider
# console shares the canonical callback above; an override that merely
# repeats OAUTH_CALLBACK_URL is drift, not configuration.
# DROPBOX_SIGN_OAUTH_CALLBACK_URL=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_MULTI_BRAND_MONTHLY=
STRIPE_PRICE_MULTI_BRAND_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
