rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function membershipId(tenantId) {
      return tenantId + "_" + request.auth.uid;
    }

    function membership(tenantId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(tenantId))).data;
    }

    function isActiveMember(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(tenantId)))
        && membership(tenantId).tenantId == tenantId
        && membership(tenantId).status == "active";
    }

    function hasRole(tenantId, roles) {
      return isActiveMember(tenantId) && membership(tenantId).role in roles;
    }

    function canManageTenant(tenantId) {
      return hasRole(tenantId, ["studio_owner"]);
    }

    function canManageProjects(tenantId) {
      return hasRole(tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
    }

    function canManageProject(tenantId, projectId) {
      return hasRole(tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(tenantId, ["studio_coordinator"])
          && isAssignedToProject(tenantId, projectId)
        );
    }

    function isStudioOperator(tenantId) {
      return hasRole(tenantId, [
          "studio_owner",
          "studio_admin",
          "studio_coordinator",
          "staff_photographer"
        ]);
    }

    function canReadContact(tenantId, projectIds) {
      return canManageProjects(tenantId)
        || (
          hasRole(tenantId, ["staff_photographer"])
          && projectIds is list
          && projectIds.hasAny(membership(tenantId).projectIds)
        );
    }

    function isAssignedToProject(tenantId, projectId) {
      return isActiveMember(tenantId)
        && projectId in membership(tenantId).projectIds;
    }

    function tenantUnchanged() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }

    function canReadCheckpoint(tenantId, projectId, visibility) {
      return hasRole(tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(tenantId, projectId)
          && (
            hasRole(tenantId, ["studio_coordinator", "staff_photographer"])
            || (hasRole(tenantId, ["subcontractor"]) && visibility in ["crew", "shared"])
          )
        );
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "photoUrl", "phone", "updatedAt", "updatedBy"]);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isPlatformAdmin() || isActiveMember(tenantId);
      allow create: if false;
      allow update: if canManageTenant(tenantId) && tenantUnchanged();
      allow delete: if false;
    }

    match /memberships/{membershipDocumentId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || canManageTenant(resource.data.tenantId);
      allow create: if canManageTenant(request.resource.data.tenantId)
        && membershipDocumentId == request.resource.data.tenantId + "_" + request.resource.data.userId;
      allow update: if canManageTenant(resource.data.tenantId) && tenantUnchanged();
      allow delete: if false;
    }

    match /tenantInvitations/{invitationId} {
      allow read: if isPlatformAdmin()
        || canManageTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /clientInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer",
            "subcontractor"
          ])
        );
      allow create: if canManageProjects(request.resource.data.tenantId)
        && request.resource.data.projectId == projectId;
      allow update: if canManageProject(resource.data.tenantId, projectId) && tenantUnchanged();
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if canReadContact(resource.data.tenantId, resource.data.projectIds);
      allow create: if canManageProjects(request.resource.data.tenantId);
      allow update: if canManageProjects(resource.data.tenantId) && tenantUnchanged();
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow create: if false;
      allow update: if canManageProjects(resource.data.tenantId) && tenantUnchanged();
      allow delete: if false;
    }

    match /eventTypeTemplates/{templateId} {
      allow read: if isStudioOperator(resource.data.tenantId);
      allow create: if hasRole(request.resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow update: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        && tenantUnchanged();
      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /packageSnapshots/{snapshotId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }

    match /workflowTemplates/{templateId} {
      allow read: if hasRole(resource.data.tenantId, [
          "studio_owner",
          "studio_admin",
          "studio_coordinator"
        ]);
      allow write: if false;
    }

    match /workflowRuns/{runId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer"
          ])
        );
      allow write: if false;
    }

    match /checkpoints/{checkpointId} {
      allow read: if canReadCheckpoint(
        resource.data.tenantId,
        resource.data.projectId,
        resource.data.visibility
      );
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer"
          ])
        );
      allow write: if false;
    }

    match /automationRuns/{runId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /automationApprovals/{approvalId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioImportSessions/{sessionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioImportItems/{itemId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioAssets/{assetId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioAssetVersions/{versionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /aiActions/{actionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }

    match /actionReceipts/{receiptId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /productEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /incidentRecords/{incidentId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /domainEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /readinessAssessments/{projectId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer"
          ])
        );
      allow write: if false;
    }

    match /auditEvents/{auditId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /consultations/{consultationId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator", "client"])
        );
      allow write: if false;
    }

    match /proposals/{proposalId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /contracts/{contractId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /invoiceReferences/{invoiceId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /documents/{documentId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator", "staff_photographer"])
            || (hasRole(resource.data.tenantId, ["subcontractor"]) && resource.data.visibility in ["crew", "shared"])
          )
        );
      allow write: if false;
    }

    match /integrationConnections/{connectionId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /integrationRouting/{tenantId} {
      allow read: if isPlatformAdmin()
        || hasRole(tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /consultationSettings/{tenantId} {
      allow read: if isPlatformAdmin()
        || hasRole(tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /bookingGateRuns/{runId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /providerJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /pdfJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /questionnaireTemplates/{templateId} {
      allow read: if isStudioOperator(resource.data.tenantId);
      allow write: if false;
    }
    match /questionnaireResponses/{responseId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","client"])
        );
      allow write: if false;
    }
    match /timingRules/{ruleId} {
      allow read: if isStudioOperator(resource.data.tenantId);
      allow write: if false;
    }
    match /vendors/{vendorId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer"])
          && resource.data.projectIds.hasAny(membership(resource.data.tenantId).projectIds)
        );
      allow write: if false;
    }
    match /insuranceRequirements/{requirementId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /insuranceRequests/{requestId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /schedules/{scheduleId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer","client"])
          )
        );
      allow write: if false;
    }
    match /crewScheduleViews/{viewId} {
      allow read: if (
        hasRole(resource.data.tenantId, ["subcontractor"])
        && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        && resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }
    match /aiJobs/{jobId} {
      allow read: if isPlatformAdmin() || hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /crewProfiles/{profileId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin","studio_coordinator"])
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewAssignments/{assignmentId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        )
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewCascades/{cascadeId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        );
      allow write: if false;
    }
    match /crewCalendarEvents/{eventId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        )
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewAvailability/{availabilityId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin","studio_coordinator"])
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /emailJobs/{jobId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /messages/{messageId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator"])
          )
        );
      allow write: if false;
    }
    match /communicationDrafts/{draftId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }
    match /messageTemplates/{templateId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    match /messageTemplatePointers/{pointerId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    match /postProductionRecords/{recordId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer"])
        );
      allow write: if false;
    }
    match /deliveryRecords/{deliveryId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /reviewRequests/{requestId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /projectCloseouts/{closeoutId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /albumWorkflows/{albumId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /albumReminders/{reminderId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /archiveHandoffs/{handoffId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /reportJobs/{jobId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }
    match /usageCounters/{counterId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /featureFlags/{flagId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /supportAccess/{accessId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /systemHealth/{healthId} {
      allow read: if isPlatformAdmin()
        || (
          resource.data.tenantId != null
          && hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        );
      allow write: if false;
    }

    match /commandExecutions/{commandId} {
      allow read, write: if false;
    }

    match /tenantOnboarding/{userId} {
      allow read, write: if false;
    }

    match /fileScans/{scanId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /exportJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }

    match /deletionRequests/{requestId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }

    match /publicRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /{collectionName}/{documentId} {
      allow read, write: if false;
    }
  }
}
