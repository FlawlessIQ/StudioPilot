rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function membershipId(tenantId) {
      return tenantId + "_" + request.auth.uid;
    }

    function membership(tenantId) {
      return get(/databases/$(database)/documents/memberships/$(membershipId(tenantId))).data;
    }

    function isActiveMember(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(tenantId)))
        && membership(tenantId).tenantId == tenantId
        && membership(tenantId).status == "active";
    }

    function hasRole(tenantId, roles) {
      return isActiveMember(tenantId) && membership(tenantId).role in roles;
    }

    function canManageTenant(tenantId) {
      return hasRole(tenantId, ["studio_owner"]);
    }

    function canManageProjects(tenantId) {
      return hasRole(tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
    }

    function canManageProject(tenantId, projectId) {
      return hasRole(tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(tenantId, ["studio_coordinator"])
          && isAssignedToProject(tenantId, projectId)
        );
    }

    function isStudioOperator(tenantId) {
      return hasRole(tenantId, [
          "studio_owner",
          "studio_admin",
          "studio_coordinator",
          "staff_photographer", "staff_videographer"
        ]);
    }

    function canReadContact(tenantId, projectIds) {
      return canManageProjects(tenantId)
        || (
          hasRole(tenantId, ["staff_photographer", "staff_videographer"])
          && projectIds is list
          && projectIds.hasAny(membership(tenantId).projectIds)
        );
    }

    function isAssignedToProject(tenantId, projectId) {
      return isActiveMember(tenantId)
        && projectId in membership(tenantId).projectIds;
    }

    // For project-keyed documents that may not exist yet: dereferencing
    // resource.data on a missing doc aborts rules evaluation, so the
    // missing-doc branch must authorize through the project document instead.
    function projectTenant(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId;
    }

    function tenantUnchanged() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }

    /**
     * The membership document id is `${tenantId}_${userId}`, and every
     * authorization decision in this file resolves it that way rather than
     * running a query. `create` enforced the relation; `update` checked only
     * that tenantId was unchanged, so an owner could rewrite `userId` and leave
     * the id and the field disagreeing.
     *
     * That is not an escalation — only an owner could do it, and an owner is
     * already the top of a tenant — but it locks the affected member out of
     * their own workspace (their membership stops matching
     * `resource.data.userId == request.auth.uid`, and nothing here can delete
     * it), it hands the membership's role and project list to whichever uid was
     * written in, and it defeats two server-side guards that identify the actor
     * by this field: MEMBER_NOT_EDITABLE and MEMBERSHIP_IDENTITY_MISMATCH.
     */
    function membershipIdentityUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function canReadCheckpoint(tenantId, projectId, visibility) {
      return hasRole(tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(tenantId, projectId)
          && (
            hasRole(tenantId, ["studio_coordinator", "staff_photographer", "staff_videographer"])
            || (hasRole(tenantId, ["subcontractor"]) && visibility in ["crew", "shared"])
          )
        );
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == userId);
      // Created by the server (onboarding, invitation acceptance). The one
      // write a browser makes is the activity heartbeat below; the profile
      // fields it could also change were never written from the app, and an
      // open write is a door nobody is watching (launch plan §5.5).
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastActiveAt"])
        // The activity heartbeat (features/auth/workspace-context.tsx): a
        // person may stamp when they were last in the app, and nothing else.
        // It is read only by the Console, as a hint, never as authority.
        && (!("lastActiveAt" in request.resource.data) || request.resource.data.lastActiveAt is string);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isPlatformAdmin() || isActiveMember(tenantId);
      allow create: if false;
      // Studio settings change through tenantIdentityCommand / tenantBrandingCommand,
      // which check the subscription and audit the change. A direct write
      // skipped both.
      allow update: if false;
      allow delete: if false;
    }

    match /memberships/{membershipDocumentId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || canManageTenant(resource.data.tenantId);
      // Seats, roles and permissions change only through membershipCommand,
      // which enforces the seat limit and audits who changed what.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /tenantInvitations/{invitationId} {
      allow read: if isPlatformAdmin()
        || canManageTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /clientInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer", "staff_videographer",
            "subcontractor"
          ])
        );
      // salesTaxExempt is set only by bookingCommand setJobSalesTaxExempt
      // (owner/admin, audited): never written straight from a browser.
      // Jobs change only through the CRM and booking commands: the state
      // machine, optimistic concurrency, the subscription guard and the audit
      // trail all live there, and a direct write bypassed every one.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if canReadContact(resource.data.tenantId, resource.data.projectIds);
      // Contacts are written by the CRM commands (and the inquiry intake).
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Changes to a signed booking. Written only by the server
    // (functions/src/contracts/amendments.ts, server/contracts/amendment-signing.ts).
    match /bookingAmendments/{amendmentId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    match /amendmentProposals/{proposalId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    // Leads change only through crmCommand (updateLead, closeInquiry, …),
    // which audits each edit and keeps the job in step. A direct browser write
    // could set status, needsConfirmation or fieldProvenance behind both.
    // A couple asking, in their portal, to add a package. Written by the
    // portal API (Admin SDK); decided through crmCommand decidePackageRequest.
    match /packageRequests/{requestId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    // A couple asked for their billing address (functions/src/billing/
    // billing-address-request.ts). Read for Today and the job; written only
    // by the scheduler, the studio's command and the portal, all server-side.
    match /billingAddressRequests/{requestId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    // A couple's change to a locked location or time, and their final-details
    // sign-off (functions/src/planning/detail-changes.ts, final-details.ts).
    // Read for Today and the job; written only server-side.
    match /detailChangeRequests/{requestId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    // The couple's own shot list (planning/shot-list-upload.ts): asked for by
    // the scheduler or the studio, sent by the couple through the portal
    // route. The studio reads it; nobody writes it from a browser.
    match /clientShotLists/{projectId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
    match /detailSignoffs/{signoffId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }
        match /leads/{leadId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // The studio's add-on library (H2). Read like packages; written only by
    // crmCommand "saveAddOn", so a price is always audited.
    match /addOns/{addOnId} {
      allow read: if canManageProjects(resource.data.tenantId);
      allow write: if false;
    }

    match /packageSnapshots/{snapshotId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }

    match /workflowTemplates/{templateId} {
      allow read: if hasRole(resource.data.tenantId, [
          "studio_owner",
          "studio_admin",
          "studio_coordinator"
        ]);
      allow write: if false;
    }

    match /workflowRuns/{runId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer", "staff_videographer"
          ])
        );
      allow write: if false;
    }

    match /checkpoints/{checkpointId} {
      allow read: if canReadCheckpoint(
        resource.data.tenantId,
        resource.data.projectId,
        resource.data.visibility
      );
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, [
            "studio_coordinator",
            "staff_photographer", "staff_videographer"
          ])
        );
      allow write: if false;
    }

    match /automationRuns/{runId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /automationApprovals/{approvalId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioImportSessions/{sessionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioImportItems/{itemId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioAssets/{assetId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /studioAssetVersions/{versionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /aiActions/{actionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }

    match /actionReceipts/{receiptId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /productEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /incidentRecords/{incidentId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /domainEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /readinessAssessments/{projectId} {
      allow read: if (
          resource != null
          && (
            hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
            || (
              isAssignedToProject(resource.data.tenantId, projectId)
              && hasRole(resource.data.tenantId, [
                "studio_coordinator",
                "staff_photographer", "staff_videographer"
              ])
            )
          )
        )
        || (
          resource == null
          && (
            hasRole(projectTenant(projectId), ["studio_owner", "studio_admin"])
            || (
              isAssignedToProject(projectTenant(projectId), projectId)
              && hasRole(projectTenant(projectId), [
                "studio_coordinator",
                "staff_photographer", "staff_videographer"
              ])
            )
          )
        );
      allow write: if false;
    }

    match /auditEvents/{auditId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /consultations/{consultationId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator", "client"])
        );
      allow write: if false;
    }

    match /proposals/{proposalId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /contracts/{contractId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    // StudioCue's own contracts (functions/src/contracts). Every write is
    // server-side; a signature is written once and never changed by anyone.
    match /contractSignatures/{signatureId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /contractDrafts/{projectId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /agreementTemplates/{templateId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
      allow write: if false;
    }

    match /agreementTemplateVersions/{versionId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
      allow write: if false;
    }

    // Features a platform admin has switched on for one studio. Members can
    // see what is on; nobody but the platform can change it.
    match /tenantFeatures/{featureTenantId} {
      allow read: if isPlatformAdmin()
        || (resource.data.tenantId == featureTenantId && isActiveMember(featureTenantId));
      allow write: if false;
    }

    match /invoiceReferences/{invoiceId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /documents/{documentId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator", "staff_photographer", "staff_videographer"])
            || (hasRole(resource.data.tenantId, ["subcontractor"]) && resource.data.visibility in ["crew", "shared"])
          )
        );
      allow write: if false;
    }

    // Autopay: saved cards (brand, last four, consent — never card data) and
    // the charges made against them. Written only by functions and the portal
    // route; the studio reads them to see where autopay stands.
    match /paymentMethods/{paymentMethodId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /autopayCharges/{chargeId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /integrationConnections/{connectionId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /integrationRouting/{tenantId} {
      allow read: if isPlatformAdmin()
        || hasRole(tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    // Sales tax mode, the proposal estimate rate, retainer review, the
    // StudioCue QuickBooks item ids (features/billing/sales-tax-settings.ts),
    // what goes on the invoices the studio issues itself (`studioInvoices`,
    // features/billing/studio-invoice-settings.ts) and the studio's last
    // per-job billing choice (features/billing/job-billing.ts).
    // Studio staff who build proposals read it; couples and crew never do.
    // Written only by integrationsCommand setBillingSettings /
    // setStudioInvoiceSettings, bookingCommand setJobBillingMethod and the
    // QuickBooks item setup.
    match /billingSettings/{tenantId} {
      allow read: if isPlatformAdmin()
        || canManageProjects(resource.data.tenantId);
      allow write: if false;
    }

    // Numbers the invoices StudioCue issues for a studio (INV-0042,
    // functions/src/billing/invoice-number.ts). Server only: a browser that
    // could move the counter could make two invoices share a number.
    match /invoiceCounters/{tenantId} {
      allow read, write: if false;
    }

    match /consultationSettings/{tenantId} {
      allow read: if isPlatformAdmin()
        || hasRole(tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    // Who sends the studio's certificates of insurance, and how far
    // StudioCue may go on its own (H3). The agent's contact details are the
    // studio's business: never a couple's or a crew member's to read. Keyed
    // by tenant; `resource.data.tenantId` so a tenant-scoped list is provable.
    match /coiSettings/{tenantId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
      allow write: if false;
    }

    // What each venue asked for last time, so the next COI there needs no typing.
    match /venueCoiProfiles/{profileId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin", "studio_coordinator"]);
      allow write: if false;
    }

    match /bookingGateRuns/{runId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /bookingOrchestrations/{projectId} {
      allow read: if (
          resource != null
          && (
            hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
            || (
              isAssignedToProject(resource.data.tenantId, resource.data.projectId)
              && hasRole(resource.data.tenantId, ["studio_coordinator"])
            )
          )
        )
        || (
          resource == null
          && (
            hasRole(projectTenant(projectId), ["studio_owner", "studio_admin"])
            || (
              isAssignedToProject(projectTenant(projectId), projectId)
              && hasRole(projectTenant(projectId), ["studio_coordinator"])
            )
          )
        );
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /providerJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /pdfJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }

    match /questionnaireTemplates/{templateId} {
      allow read: if isStudioOperator(resource.data.tenantId);
      allow write: if false;
    }
    // The crew's part of a client's submitted brief — projected server-side by
    // crewBriefOnQuestionnaireWrite, because questionnaireResponses holds
    // billing contacts, approvers and private emails crew must not read. Only
    // people assigned to the job, and never the client (who has the original).
    match /crewBriefs/{briefId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer", "staff_videographer","subcontractor"])
        );
      allow write: if false;
    }
    match /questionnaireResponses/{responseId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","client"])
        );
      allow write: if false;
    }
    match /timingRules/{ruleId} {
      allow read: if isStudioOperator(resource.data.tenantId);
      allow write: if false;
    }
    match /vendors/{vendorId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer", "staff_videographer"])
          && resource.data.projectIds.hasAny(membership(resource.data.tenantId).projectIds)
        );
      allow write: if false;
    }
    match /insuranceRequirements/{requirementId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /insuranceRequests/{requestId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /schedules/{scheduleId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer", "staff_videographer","client"])
          )
        );
      allow write: if false;
    }
    // Run-of-show shares to external vendors. The studio reads them to see who
    // has viewed/acknowledged; the token holder (the vendor) never touches
    // Firestore — the public route resolves the token with admin credentials.
    match /scheduleShares/{shareId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer", "staff_videographer"])
        );
      allow write: if false;
    }
    match /crewScheduleViews/{viewId} {
      allow read: if (
        hasRole(resource.data.tenantId, ["subcontractor"])
        && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        && resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }
    match /aiJobs/{jobId} {
      allow read: if isPlatformAdmin() || hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /crewProfiles/{profileId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin","studio_coordinator"])
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewAssignments/{assignmentId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        )
        // Their own assignment, membership or not. Project access is granted on
        // acceptance, so an outstanding offer used to be unreadable by the one
        // person it was addressed to: the crew workspace said "nothing needs
        // you right now" while an offer sat in their email, on a product whose
        // headline measure is accepting within fifteen minutes. This document
        // is the offer — role, times, place, fee — and nothing else about the
        // job travels with it.
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewCascades/{cascadeId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        );
      allow write: if false;
    }
    /**
     * The staffing plan booking prepares. Studio-side only: it names who the
     * studio is considering and what it intends to pay them, which is not a
     * crew member's business and never a client's. Written by the booking
     * worker alone.
     */
    match /crewStaffingPlans/{planId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        );
      allow write: if false;
    }
    match /crewCalendarEvents/{eventId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        )
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /crewAvailability/{availabilityId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin","studio_coordinator"])
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    // Group events (features/group-events/participants.ts): the parents on
    // an event's roster. Read by the studio — owners and admins, and a
    // coordinator assigned to the job — and by the crew assigned to that
    // event, who take payment at the field (sign-up, 2026-10-10). Written
    // only by crmCommand and the public sign-up route. Never by the parents
    // themselves, and never by the job's client (the organiser).
    match /eventParticipants/{participantId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer","staff_videographer","subcontractor"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        );
      allow write: if false;
    }
    match /crewMessages/{messageId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        )
        || (
          hasRole(resource.data.tenantId, ["subcontractor"])
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }
    match /emailJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && resource.data.projectId != null
          && isAssignedToProject(resource.data.tenantId, resource.data.projectId)
        );
      allow write: if false;
    }
    // Inbound mail that could not be matched to a thread, or that was
    // recognised as automated. Kept rather than dropped so a client's email is
    // never silently lost, and readable by owners and admins so someone can act
    // on it.
    // Server-only. The token in the studio's email is the capability; the
    // document behind it holds a client's question and must not be readable by
    // anyone who guesses a hash.
    match /replyApprovals/{tokenHash} {
      allow read: if false;
      allow write: if false;
    }
    // Inbox capture. What was read from each captured email, and the studio's
    // capture settings (learned senders, per-form field mappings). Written
    // only by the inbound route and the capture commands, which check who is
    // asking; a browser that could write a mapping could redirect a couple's
    // email address into any field, and one that could write the sender lists
    // could silently stop inquiries being captured.
    match /inboundCaptures/{captureId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    match /leadCaptureSettings/{tenantId} {
      allow read: if hasRole(tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    // Server-only in both directions. An unmatched message has no reliable
    // tenantId — that is why it is here — so there is no tenant to scope a read
    // to, and any broader rule would expose one studio's client mail to
    // another's. Inspected through logs and platform tooling, not the app.
    match /inboundEmailQuarantine/{entryId} {
      allow read: if false;
      allow write: if false;
    }
    // Threads are studio-read; the client portal reaches its own conversation
    // through the portal API route, which filters by project membership. Writes
    // are server-only: unread counts are folded in a transaction and a client
    // that could increment them could also hide a message.
    match /conversations/{conversationId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /messages/{messageId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && (
            hasRole(resource.data.tenantId, ["studio_coordinator"])
          )
        );
      allow write: if false;
    }
    match /communicationDrafts/{draftId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          hasRole(resource.data.tenantId, ["studio_coordinator"])
          && (
            resource.data.projectId == null
            || isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          )
        );
      allow write: if false;
    }
    match /messageTemplates/{templateId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    match /messageTemplatePointers/{pointerId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"]);
      allow write: if false;
    }
    match /postProductionRecords/{recordId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator","staff_photographer", "staff_videographer"])
        );
      allow write: if false;
    }
    match /deliveryRecords/{deliveryId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /galleryInboxes/{projectId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }

    match /deliveryDrafts/{draftId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner", "studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /reviewRequests/{requestId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /projectCloseouts/{closeoutId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /albumWorkflows/{albumId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        || (
          isAssignedToProject(resource.data.tenantId, resource.data.projectId)
          && hasRole(resource.data.tenantId, ["studio_coordinator"])
        );
      allow write: if false;
    }
    match /albumReminders/{reminderId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /archiveHandoffs/{handoffId} {
      allow read: if hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }
    match /usageCounters/{counterId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner","studio_admin"]);
      allow write: if false;
    }
    match /featureFlags/{flagId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /supportAccess/{accessId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    // The StudioCue Console (docs/console.md). Summary rows derived from the
    // records above, and the team's own notes, tasks, issues and billing
    // mirrors. Platform admins read; only Console commands and the rollup
    // write. Studios never see any of it — internal notes above all.
    match /consoleStudios/{tenantId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consolePeople/{userId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consoleNotes/{noteId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consoleTasks/{taskId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consoleMetrics/{day} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consoleSettings/{settingId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /consoleReplies/{replyId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /platformAdmins/{userId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /issues/{issueId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /saasInvoices/{invoiceId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /saasDiscounts/{discountId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    // Studio referrals (Console → Referrals, saas/referrals.ts): every
    // studio's code, the studios that signed up with one, the quarterly
    // credits, and the vendors invited. Written only by billingCommand, the
    // Stripe webhook and the schedulers. A studio sees its own through
    // billingCommand, never these documents.
    match /saasReferrals/{tenantId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /saasReferralCodes/{code} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /saasReferralCredits/{creditId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /vendorInvites/{emailHash} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    // Addresses that opted out of StudioCue's own sales mail. Written by the
    // unsubscribe route; read only by the server.
    match /emailSuppressions/{emailHash} {
      allow read, write: if false;
    }
    // Where each studio came from (Console → Sources): the signup link and
    // "How did you hear about StudioCue?", written by tenantOnboardingCommand,
    // and the channel an operator filed it under. Never readable by a studio.
    // Console → Pipeline: photographers who might become studios. Written by
    // saasAdminCommand, by the demo form's server route, and by onboarding
    // when one signs up.
    match /saasLeads/{leadId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    // Console → Lifecycle: a studio's stage changes, written by the rollup.
    match /consoleLifecycleEvents/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /saasAttribution/{tenantId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    // The thread on a piece of feedback. The team reads all of it; the person
    // who sent the feedback reads only the replies the team sent them, never an
    // internal note.
    match /feedbackMessages/{messageId} {
      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.visibleToSender == true
          && resource.data.senderUserId == request.auth.uid
        );
      allow write: if false;
    }
    // Feedback a studio sent the StudioCue team (functions/src/feedback).
    // The person who sent it reads their own, in the studio they sent it
    // from, so "Your feedback" can show where each one stands; the team reads
    // all of it. Only the feedback command writes.
    match /feedback/{feedbackId} {
      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && isActiveMember(resource.data.tenantId)
        );
      allow write: if false;
    }
    match /feedbackRateLimits/{userId} {
      allow read, write: if false;
    }
    match /systemHealth/{healthId} {
      allow read: if isPlatformAdmin()
        || (
          resource.data.tenantId != null
          && hasRole(resource.data.tenantId, ["studio_owner","studio_admin"])
        );
      allow write: if false;
    }

    match /commandExecutions/{commandId} {
      allow read, write: if false;
    }

    match /tenantOnboarding/{userId} {
      allow read, write: if false;
    }

    match /fileScans/{scanId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /exportJobs/{jobId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }

    match /deletionRequests/{requestId} {
      allow read: if isPlatformAdmin()
        || hasRole(resource.data.tenantId, ["studio_owner"]);
      allow write: if false;
    }

    match /oauthStates/{stateId} {
      allow read, write: if false;
    }

    match /publicRateLimits/{limitId} {
      allow read, write: if false;
    }

    // A group event's public sign-up link, looked up by the token's hash. The
    // server alone reads it (app/api/public/event-signup); studios see the
    // link on the job.
    match /eventSignupLinks/{linkId} {
      allow read, write: if false;
    }

    match /{collectionName}/{documentId} {
      allow read, write: if false;
    }
  }
}
