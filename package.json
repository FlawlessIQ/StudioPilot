{
  "name": "studiohub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/permissions.test.ts tests/project-state.test.ts tests/project-service.test.ts tests/schemas.test.ts tests/providers.test.ts tests/entitlements.test.ts tests/package-snapshot.test.ts tests/lead-intake.test.ts tests/workflow-engine.test.ts tests/readiness-engine.test.ts tests/checkpoint-service.test.ts tests/automation-engine.test.ts tests/booking-gate.test.ts tests/consultation-service.test.ts tests/invoice-scheduling.test.ts tests/booking-providers.test.ts tests/schedule-service.test.ts tests/coi-service.test.ts tests/inbound-coi.test.ts tests/crew-service.test.ts tests/post-event-service.test.ts tests/saas-operations.test.ts tests/stripe-webhook-relay.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"tsx --test tests/firestore-rules.test.ts\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage \"tsx --test tests/storage-rules.test.ts\"",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "seed": "tsx scripts/seed.ts",
    "secrets:provision": "bash scripts/configure-production-secrets.sh studiohub-prod provision",
    "secrets:initialize": "bash scripts/initialize-production-owned-secrets.sh studiohub-prod",
    "secrets:status": "bash scripts/configure-production-secrets.sh studiohub-prod status",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.24.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "6.1.3"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
