rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function membership(tenantId) {
      return firestore.get(
        /databases/(default)/documents/memberships/$(tenantId + "_" + request.auth.uid)
      ).data;
    }

    function activeMember(tenantId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/memberships/$(tenantId + "_" + request.auth.uid)
        )
        && membership(tenantId).tenantId == tenantId
        && membership(tenantId).status == "active";
    }

    function safeUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.metadata.scanStatus == "pending"
        && request.resource.contentType.matches(
          "application/pdf|image/jpeg|image/png|application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        );
    }

    function safeStudioImportUpload(tenantId, sessionId, itemId, uploadId, fileName) {
      let item = firestore.get(
        /databases/(default)/documents/studioImportItems/$(itemId)
      ).data;
      return item.tenantId == tenantId
        && item.sessionId == sessionId
        && item.uploadId == uploadId
        && item.status == "awaiting_upload"
        && item.expectedObjectName == request.resource.name
        && item.sizeBytes == request.resource.size
        && item.contentType == request.resource.contentType
        && request.resource.size > 0
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.metadata.scanStatus == "pending"
        && request.resource.metadata.visibility == "studio"
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.importSessionId == sessionId
        && request.resource.metadata.importItemId == itemId
        && request.resource.metadata.uploadId == uploadId
        && request.resource.metadata.uploaderId == request.auth.uid
        && fileName.matches(
          "source\\.(pdf|doc|docx|txt|csv|rtf)"
        )
        && request.resource.contentType.matches(
          "application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain|text/csv|application/rtf|text/rtf|application/octet-stream"
        );
    }

    match /tenants/{tenantId}/studio-imports/{sessionId}/{itemId}/{uploadId}/{fileName} {
      allow read: if resource.metadata.scanStatus == "clean"
        && activeMember(tenantId)
        && membership(tenantId).role in ["studio_owner", "studio_admin"];
      allow create: if activeMember(tenantId)
        && membership(tenantId).role in ["studio_owner", "studio_admin"]
        && resource == null
        && safeStudioImportUpload(
          tenantId,
          sessionId,
          itemId,
          uploadId,
          fileName
        );
      allow update, delete: if false;
    }

    match /tenants/{tenantId}/projects/{projectId}/crew/{userId}/{allPaths=**} {
      allow read: if resource.metadata.scanStatus == "clean"
        && activeMember(tenantId)
        && (
          membership(tenantId).role in ["studio_owner", "studio_admin", "studio_coordinator"]
          || (
            request.auth.uid == userId
            && projectId in membership(tenantId).projectIds
          )
        );
      allow write: if activeMember(tenantId)
        && request.auth.uid == userId
        && membership(tenantId).role == "subcontractor"
        && projectId in membership(tenantId).projectIds
        && resource == null
        && safeUpload()
        // safeUpload() constrains size, type and scan status but says nothing
        // about visibility, so a W-9 or an insurance certificate could be
        // uploaded as "shared" — which the project-wide rule below then hands
        // to the couple. A crew document is crew-visible, full stop.
        && request.resource.metadata.visibility == "crew";
    }

    match /tenants/{tenantId}/projects/{projectId}/clients/{userId}/questionnaires/{responseId}/{fileName} {
      allow read: if resource.metadata.scanStatus == "clean"
        && activeMember(tenantId)
        && (
          membership(tenantId).role in ["studio_owner", "studio_admin", "studio_coordinator"]
          || (
            projectId in membership(tenantId).projectIds
            && membership(tenantId).role == "client"
            && request.auth.uid == userId
          )
        );
      allow create: if activeMember(tenantId)
        && membership(tenantId).role == "client"
        && request.auth.uid == userId
        && projectId in membership(tenantId).projectIds
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches(
          "application/pdf|image/jpeg|image/png|application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        )
        && request.resource.metadata.scanStatus == "pending"
        && request.resource.metadata.visibility == "client"
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.projectId == projectId
        && request.resource.metadata.responseId == responseId
        && request.resource.metadata.uploaderId == request.auth.uid
        && firestore.exists(
          /databases/(default)/documents/questionnaireResponses/$(responseId)
        )
        && firestore.get(
          /databases/(default)/documents/questionnaireResponses/$(responseId)
        ).data.tenantId == tenantId
        && firestore.get(
          /databases/(default)/documents/questionnaireResponses/$(responseId)
        ).data.projectId == projectId;
      allow update, delete: if false;
    }

    match /tenants/{tenantId}/projects/{projectId}/clients/{userId}/messages/{draftId}/{fileName} {
      allow read: if resource.metadata.scanStatus == "clean"
        && activeMember(tenantId)
        && (
          membership(tenantId).role in ["studio_owner", "studio_admin", "studio_coordinator"]
          || (
            projectId in membership(tenantId).projectIds
            && membership(tenantId).role == "client"
            && request.auth.uid == userId
          )
        );
      allow create: if activeMember(tenantId)
        && membership(tenantId).role == "client"
        && request.auth.uid == userId
        && projectId in membership(tenantId).projectIds
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType.matches(
          "application/pdf|image/jpeg|image/png|application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        )
        && request.resource.metadata.scanStatus == "pending"
        && request.resource.metadata.visibility == "shared"
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.projectId == projectId
        && request.resource.metadata.messageDraftId == draftId
        && request.resource.metadata.uploaderId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * The project's own files — and *only* those.
     *
     * Storage grants access when **any** matching rule allows it, so this
     * catch-all silently re-granted everything the three narrower blocks above
     * exist to restrict. Two consequences were live:
     *
     *   - Every subcontractor on a job could read every other subcontractor's
     *     folder: W-9s and insurance certificates, which the crew block limits
     *     to the owner of the folder and the studio's operators.
     *   - Either partner in a couple could read the other's questionnaire
     *     upload, which the questionnaire block limits with
     *     `request.auth.uid == userId`. That upload is *required* to carry
     *     visibility "client", so this one needed no misconfiguration at all.
     *
     * The delegated subtrees are excluded here and authorized only by their own
     * block, which is what the narrower rules were written to mean.
     */
    function notDelegatedSubtree(objectName) {
      // `{allPaths=**}` binds a Path, not a string, so calling `.matches()` on
      // it errors and denies everything. The object's own full name is a
      // string. `matches` is a full match, hence the wildcards on both ends.
      return !objectName.matches(".*/(crew|clients)/.*");
    }

    match /tenants/{tenantId}/projects/{projectId}/{allPaths=**} {
      allow read: if notDelegatedSubtree(resource.name)
        && resource.metadata.scanStatus == "clean"
        && activeMember(tenantId)
        && (
          membership(tenantId).role in ["studio_owner", "studio_admin", "studio_coordinator"]
          || (
            projectId in membership(tenantId).projectIds
            && (
              (
                membership(tenantId).role == "client"
                && resource.metadata.visibility in ["client", "shared"]
              )
              || (
                membership(tenantId).role in ["staff_photographer", "subcontractor"]
                && resource.metadata.visibility in ["crew", "shared"]
              )
            )
          )
        );
      allow create, update: if notDelegatedSubtree(request.resource.name)
        && activeMember(tenantId)
        && membership(tenantId).role in ["studio_owner", "studio_admin", "studio_coordinator"]
        && safeUpload();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
